+void Application::forgetView(View* view)
+{
+    // Remembered for a screen below: that screen gets its default focus back when it shows again.
+    for (View*& saved : Application::focusStack)
+        if (saved == view)
+            saved = nullptr;
+
+    if (Application::currentFocus != view)
+        return;
+    Application::currentFocus = nullptr;
+    // Once the deletion is over, the top screen's default focus.
+    brls::sync([] {
+        if (!Application::currentFocus && !Application::activitiesStack.empty())
+            Application::giveFocus(Application::activitiesStack.back()->getDefaultFocus());
+    });
+}
