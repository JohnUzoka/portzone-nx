diff --git a/library/lib/platforms/switch/switch_font.cpp b/library/lib/platforms/switch/switch_font.cpp
index 586b243..50e9ee9 100644
--- a/library/lib/platforms/switch/switch_font.cpp
+++ b/library/lib/platforms/switch/switch_font.cpp
@@ -33,10 +33,12 @@ void SwitchFontLoader::loadFonts()
     brls::Logger::info("switch system locale: {}", brls::Application::getPlatform()->getLocale());
 
     // custom Font
-    if (this->loadFontFromFile(FONT_REGULAR, USER_FONT_PATH))
+    const bool customFont = this->loadFontFromFile(FONT_REGULAR, USER_FONT_PATH);
+    if (customFont)
     {
         brls::Logger::info("Load custom font: {}", USER_FONT_PATH);
     }
+#ifndef BOREALIS_NO_SHARED_FONTS // PortZone: emulator test builds run without the system's font archive
     else
     {
         brls::Logger::warning("Cannot find custom font, (Searched at: {})", USER_FONT_PATH);
@@ -46,6 +48,16 @@ void SwitchFontLoader::loadFonts()
             Application::loadFontFromMemory(FONT_REGULAR, font.address, font.size, false);
     }
 
+    // PortZone: a custom font covers Latin text only; the console's Standard font (Japanese) fills in after it.
+    if (customFont)
+    {
+        rc = plGetSharedFontByType(&font, PlSharedFontType_Standard);
+        if (R_SUCCEEDED(rc) && Application::loadFontFromMemory("standard", font.address, font.size, false))
+            nvgAddFallbackFontId(vg, Application::getFont(FONT_REGULAR), Application::getFont("standard"));
+        else
+            Logger::error("switch: could not load Standard shared font: {:#x}", rc);
+    }
+
     // Simplified Chinese
     rc = plGetSharedFontByType(&font, PlSharedFontType_ChineseSimplified);
     if (R_SUCCEEDED(rc) && Application::loadFontFromMemory(FONT_CHINESE_SIMPLIFIED, font.address, font.size, false))
@@ -80,6 +92,7 @@ void SwitchFontLoader::loadFonts()
         nvgAddFallbackFontId(vg, Application::getFont(FONT_REGULAR), Application::getFont(FONT_SWITCH_ICONS));
     else
         Logger::error("switch: could not load Extended shared font: {:#x}", rc);
+#endif
 
     // Material icons
     if (this->loadMaterialFromResources())
