{
  "format": 1,
  "manifests": {
    "haloce-nx": {
      "source": "store draft",
      "portzone": {
        "$schema": "https://raw.githubusercontent.com/JohnUzoka/portzone-nx/main/store/schema/portzone.schema.json",
        "format": 1,
        "description": "Halo: Combat Evolved from the decompilation, drawn with deko3d, with online play through OpenCE. Needs your own Xbox disc image.",
        "banner": "docs/images/switch-online.jpg",
        "platform": {
          "original": "Xbox",
          "runs_on": [
            "switch"
          ]
        },
        "install": {
          "binary": "sdmc:/haloce-nx/halo.nro",
          "steps": [
            {
              "asset": "halo-switch-release.zip",
              "unzip": "sdmc:/haloce-nx"
            }
          ]
        },
        "launch": {
          "full_memory": true,
          "notes": [
            "The game updates itself from its GitHub releases, asking first."
          ]
        },
        "game_data": {
          "dir": "sdmc:/haloce-nx",
          "inputs": [
            {
              "id": "game",
              "label": "Halo: Combat Evolved Xbox disc image",
              "options": [
                {
                  "label": "Disc image (.iso)",
                  "files": [
                    {
                      "path": "*.iso",
                      "note": "Your Xbox disc"
                    }
                  ]
                },
                {
                  "label": "Disc image (.xiso)",
                  "files": [
                    {
                      "path": "*.xiso",
                      "note": "Your Xbox disc"
                    }
                  ]
                }
              ]
            },
            {
              "id": "custom-maps",
              "label": "Custom Edition maps",
              "required": false,
              "options": [
                {
                  "label": "Map files",
                  "files": [
                    {
                      "path": "custom_maps/",
                      "match": "*.map",
                      "note": "Sent by the host to players who lack them"
                    }
                  ]
                }
              ]
            }
          ],
          "prepare": {
            "where": "switch",
            "summary": "The first start copies the maps and movies out of the disc image, then starts the game.",
            "done": [
              "maps/",
              "bink/"
            ]
          },
          "generated": [
            {
              "path": "maps/",
              "note": "Game data from your disc"
            },
            {
              "path": "bink/",
              "note": "Movies from your disc"
            },
            {
              "path": "icon.jpg",
              "note": "The game's icon, for a forwarder"
            },
            {
              "path": "config.toml",
              "note": "Settings"
            },
            {
              "path": "profiles/",
              "note": "Player profiles"
            },
            {
              "path": "saves/",
              "note": "Checkpoints and saved games"
            },
            {
              "path": "cache/",
              "note": "Map caches, safe to delete"
            },
            {
              "path": "logs/",
              "note": "halo.log, debug.txt, gamestate.txt"
            }
          ]
        },
        "steps": [
          "Make an image of your own Halo: Combat Evolved Xbox disc (.iso or .xiso).",
          "Copy it to haloce-nx/ at the root of the SD card.",
          "Start halo.nro with full memory. The first start copies the game data out of the image."
        ]
      }
    },
    "nfsmw-nx": {
      "source": "store draft",
      "portzone": {
        "$schema": "https://raw.githubusercontent.com/JohnUzoka/portzone-nx/main/store/schema/portzone.schema.json",
        "format": 1,
        "description": "Need for Speed: Most Wanted (2005, Xbox 360), statically recompiled with ReXGlue and drawn with Vulkan on NVK: 30 FPS at stock clocks. Needs your own Xbox 360 disc, converted on a PC.",
        "banner": "extras/banner.png",
        "platform": {
          "original": "Xbox 360",
          "runs_on": [
            "switch"
          ]
        },
        "install": {
          "binary": "sdmc:/switch/nfsmw-nx/nfsmw-nx.nro"
        },
        "launch": {
          "full_memory": true,
          "notes": [
            "A forwarder must be set to a 39-bit address space.",
            "The first race after installing or updating can stutter for a few seconds while it compiles graphics pipelines; later sessions start smoothly."
          ]
        },
        "game_data": {
          "dir": "sdmc:/switch/nfsmw-nx",
          "inputs": [
            {
              "id": "game",
              "label": "Files made by the nfsmw-nx installer from your Xbox 360 disc",
              "options": [
                {
                  "label": "nfsmw-nx.zip, extracted",
                  "files": [
                    {
                      "path": "nfsmw-nx.nro",
                      "note": "The game, the build for your disc's edition"
                    },
                    {
                      "path": "nfsmw.toml",
                      "note": "Settings"
                    },
                    {
                      "path": "nfsmw_shaders.nfsp",
                      "note": "The game's shaders, made from your disc"
                    },
                    {
                      "path": "game_root/",
                      "markers": [
                        "default.xex",
                        "NFS/"
                      ],
                      "note": "The files of your disc"
                    }
                  ]
                }
              ]
            }
          ],
          "prepare": {
            "where": "pc",
            "summary": "The installer page reads your disc image (.iso) or extracted disc in the browser, picks your edition's build and makes the shaders from your disc.",
            "tool": {
              "name": "nfsmw-nx installer",
              "url": "https://stevensnd.github.io/nfsmw-nx-installer/"
            }
          }
        },
        "steps": [
          "On a PC, open https://stevensnd.github.io/nfsmw-nx-installer/",
          "Choose your disc image (.iso), or the folder with default.xex, Movies and NFS, and press Create nfsmw-nx.zip.",
          "Extract nfsmw-nx.zip into switch/ on the SD card, or drop the extracted nfsmw-nx folder on PortZone's upload page. It makes switch/nfsmw-nx/.",
          "Start nfsmw-nx.nro with full memory."
        ]
      }
    },
    "sa2-nx": {
      "source": "store draft",
      "portzone": {
        "$schema": "https://raw.githubusercontent.com/JohnUzoka/portzone-nx/main/store/schema/portzone.schema.json",
        "format": 1,
        "description": "Sonic Adventure 2 (Xbox Live Arcade), statically recompiled with ReXGlue and drawn with deko3d: 60 FPS at stock clocks. Needs your own Xbox 360 copy, converted on a PC.",
        "icon": "tools/switch/icon/sa2_icon.jpg",
        "platform": {
          "original": "Xbox 360",
          "runs_on": [
            "switch"
          ]
        },
        "install": {
          "binary": "sdmc:/switch/sa2-nx/sa2.nro",
          "steps": [
            {
              "asset": "sa2.nro",
              "copy": "sdmc:/switch/sa2-nx"
            }
          ]
        },
        "launch": {
          "full_memory": true,
          "notes": [
            "A forwarder must be set to a 39-bit address space.",
            "Hold A+B+X+Y+L+R for the game menu."
          ]
        },
        "game_data": {
          "dir": "sdmc:/switch/sa2-nx",
          "inputs": [
            {
              "id": "game",
              "label": "Game files made by the web installer from your Xbox 360 copy",
              "options": [
                {
                  "label": "sa2-nx.zip, extracted to the SD root",
                  "files": [
                    {
                      "path": "game_root.nxpack",
                      "note": "The game's files, about 1.2 GB"
                    },
                    {
                      "path": "game_root.nxidx",
                      "note": "Index of the pack"
                    },
                    {
                      "path": "deko3d_glsl.bin",
                      "note": "Shaders made from your copy"
                    }
                  ]
                }
              ]
            }
          ],
          "prepare": {
            "where": "pc",
            "summary": "The installer page converts your Xbox 360 package in the browser: movies to H.265, music to Opus, everything else into one pack.",
            "tool": {
              "name": "sa2-nx web installer",
              "url": "https://chanseyisthebest.github.io/sa2-nx-installer/"
            }
          },
          "generated": [
            {
              "path": "sa2.toml",
              "note": "Settings; delete it to get the defaults back"
            }
          ]
        },
        "steps": [
          "On a PC, open https://chanseyisthebest.github.io/sa2-nx-installer/",
          "Give it the package file 525E7BB1E72A2DB99AB79281BA24938048198FAD58, or the whole 58411202 folder from your Xbox 360 (the Battle DLC is optional), and press Create sa2-nx.zip.",
          "Extract sa2-nx.zip to the root of the SD card. It makes switch/sa2-nx/.",
          "Start sa2.nro with full memory."
        ]
      }
    },
    "triaevum": {
      "source": "store draft",
      "portzone": {
        "$schema": "https://raw.githubusercontent.com/JohnUzoka/portzone-nx/main/store/schema/portzone.schema.json",
        "format": 1,
        "description": "TriAevum, the Ocarina of Time 3D recompilation, on Switch with gyro aiming, touch controls and in-game updates. Needs your own decrypted cartridge dump.",
        "icon": "res/switch/icon.jpg",
        "platform": {
          "original": "3DS",
          "runs_on": [
            "switch"
          ]
        },
        "install": {
          "binary": "sdmc:/switch/oot3dre/oot3d_native_game.nro",
          "steps": [
            {
              "asset": "-switch.zip",
              "unzip": "sdmc:/"
            }
          ]
        },
        "launch": {
          "full_memory": true,
          "notes": [
            "A Sphaira forwarder works. Forwarders from the nsp-forwarder website have been reported to close the game.",
            "Press both sticks in (L3+R3) for settings, the performance overlay and updates."
          ]
        },
        "game_data": {
          "dir": "sdmc:/switch/oot3dre",
          "inputs": [
            {
              "id": "game",
              "label": "Ocarina of Time 3D cartridge dump, decrypted: USA Rev 1, or European (original or Rev 1)",
              "options": [
                {
                  "label": "Cartridge dump (.3ds)",
                  "files": [
                    {
                      "path": "*.3ds",
                      "note": "Your decrypted dump"
                    }
                  ]
                },
                {
                  "label": "Cartridge dump (.cci)",
                  "files": [
                    {
                      "path": "*.cci",
                      "note": "Your decrypted dump"
                    }
                  ]
                },
                {
                  "label": "Extracted dump",
                  "files": [
                    {
                      "path": "import/code.bin",
                      "note": "Decompressed code"
                    },
                    {
                      "path": "import/exheader.bin",
                      "note": "ExHeader"
                    },
                    {
                      "path": "import/romfs.bin",
                      "note": "RomFS (IVFC)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "topscreen",
              "label": "Single Screen Experience HUD art, for consoles without internet",
              "required": false,
              "options": [
                {
                  "label": "Downloaded on a PC from GameBanana",
                  "url": "https://gamebanana.com/mods/695893",
                  "files": [
                    {
                      "path": "singlescreen_322.zip",
                      "note": "The game offers to download it itself when online"
                    }
                  ]
                }
              ]
            },
            {
              "id": "hd-textures",
              "label": "HD texture pack (HenrikoMagnifico, 1080p)",
              "required": false,
              "options": [
                {
                  "label": "Shrunk on a PC with shrink_texture_pack.py",
                  "url": "https://www.henrikomagnifico.com/zelda-ocarina-of-time-3d-4k",
                  "files": [
                    {
                      "path": "textures/",
                      "markers": [
                        "pack.json"
                      ],
                      "note": "Turn on in L3+R3, Video, HD textures"
                    }
                  ]
                }
              ]
            }
          ],
          "prepare": {
            "where": "switch",
            "summary": "The first start turns your dump into the game files (about a minute), then asks whether to keep the dump.",
            "done": [
              "game/code.bin",
              "game/exheader.bin",
              "game/romfs.bin"
            ]
          },
          "generated": [
            {
              "path": "game/",
              "note": "Game files made from your dump"
            },
            {
              "path": "config/",
              "note": "Settings"
            },
            {
              "path": "logs/",
              "note": "Logs, for bug reports"
            },
            {
              "path": "mods/",
              "note": "Your RomFS mods, one folder each"
            }
          ]
        },
        "steps": [
          "Have your own cartridge dump ready as a .3ds or .cci file (USA Rev 1, or European original or Rev 1). eShop copies (.cia) and other versions do not work.",
          "Copy the .3ds or .cci file to switch/oot3dre/.",
          "Start the game with full memory. The first start imports the dump."
        ]
      }
    }
  }
}
